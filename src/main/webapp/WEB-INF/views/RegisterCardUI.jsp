<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/tags.jspf" %>
<c:set var="title" value="Đăng kí thẻ bạn đọc"/><c:set var="active" value="register"/>
<%@ include file="common/header.jspf" %>
<c:choose><c:when test="${not empty registrationResult}">
<section class="success card"><div class="success-icon" aria-hidden="true">✓</div><p class="eyebrow">CHÀO MỪNG BẠN ĐỌC MỚI</p><h1>Đăng kí thẻ thành công!</h1><p class="subtitle">Tài khoản và thẻ của bạn đã được tạo. Hãy lưu lại mã bạn đọc và mã thẻ để sử dụng tại thư viện.</p>
<div class="mini-card"><div class="library">LIBRARY / THẺ BẠN ĐỌC</div><div class="card-name"><c:out value="${registrationResult.reader.fullName}"/></div><small>MÃ BẠN ĐỌC</small><div><c:out value="${registrationResult.reader.readerID}"/></div><small>MÃ THẺ</small><div>TV<c:out value="${registrationResult.id}"/></div></div>
<dl class="metadata"><div><dt>Tên đăng nhập</dt><dd><c:out value="${registrationResult.reader.userName}"/></dd></div><div><dt>Trạng thái</dt><dd><ui:status value="${registrationResult.status}"/></dd></div><div><dt>Ngày cấp</dt><dd><ui:date value="${registrationResult.issueDate}"/></dd></div><div><dt>Ngày hết hạn</dt><dd><ui:date value="${registrationResult.expiryDate}"/></dd></div></dl>
<div class="actions"><a class="btn" href="${pageContext.request.contextPath}/MainCustomerUI.jsp">OK · Về trang chính</a></div></section>
</c:when><c:otherwise>
<h1>Đăng kí thẻ bạn đọc</h1>
<div class="registration-layout"><section class="card"><div class="card-head"><div><h2>Thông tin đăng kí</h2><p>Các trường có dấu <span class="required">*</span> là bắt buộc.</p></div><span class="step">Cấp thẻ trực tuyến</span></div>
<c:if test="${not empty errors}"><div class="notice error" role="alert"><b>Chưa thể hoàn tất đăng kí.</b><c:if test="${not empty errors.global}"><p><c:out value="${errors.global}"/></p></c:if><p>Kiểm tra thông tin bên dưới và nhập lại mật khẩu.</p></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/doRegisterCard.jsp">
<input type="hidden" name="csrf" value="${sessionScope.csrf}">
<div class="form-grid">
<div class="field full"><label for="userName">Tên đăng nhập <span class="required">*</span></label><input id="userName" name="userName" autocomplete="username" required minlength="4" maxlength="50" pattern="[A-Za-z0-9_]{4,50}" value="<c:out value='${values.userName}'/>"><small>4–50 chữ cái không dấu, chữ số hoặc dấu gạch dưới.</small><c:if test="${not empty errors.userName}"><span class="field-error"><c:out value="${errors.userName}"/></span></c:if></div>
<div class="field"><label for="passWord">Mật khẩu <span class="required">*</span></label><input id="passWord" name="passWord" type="password" autocomplete="new-password" required minlength="8" maxlength="128"><small>Từ 8 đến 128 ký tự.</small><c:if test="${not empty errors.passWord}"><span class="field-error"><c:out value="${errors.passWord}"/></span></c:if></div>
<div class="field"><label for="confirmPass">Xác nhận mật khẩu <span class="required">*</span></label><input id="confirmPass" name="confirmPass" type="password" autocomplete="new-password" required minlength="8" maxlength="128"><c:if test="${not empty errors.confirmPass}"><span class="field-error"><c:out value="${errors.confirmPass}"/></span></c:if></div>
<div class="field"><label for="fullName">Họ và tên <span class="required">*</span></label><input id="fullName" name="fullName" autocomplete="name" required maxlength="100" value="<c:out value='${values.fullName}'/>"><c:if test="${not empty errors.fullName}"><span class="field-error"><c:out value="${errors.fullName}"/></span></c:if></div>
<div class="field"><label for="dayOfBirth">Ngày sinh <span class="required">*</span></label><input id="dayOfBirth" name="dayOfBirth" type="date" autocomplete="bday" required max="${today}" value="<c:out value='${values.dayOfBirth}'/>"><c:if test="${not empty errors.dayOfBirth}"><span class="field-error"><c:out value="${errors.dayOfBirth}"/></span></c:if></div>
<div class="field"><label for="email">Email <span class="required">*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="100" value="<c:out value='${values.email}'/>"><c:if test="${not empty errors.email}"><span class="field-error"><c:out value="${errors.email}"/></span></c:if></div>
<div class="field"><label for="phone">Số điện thoại <span class="required">*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" required pattern="\+?[0-9]{9,14}" maxlength="15" value="<c:out value='${values.phone}'/>"><c:if test="${not empty errors.phone}"><span class="field-error"><c:out value="${errors.phone}"/></span></c:if></div>
</div><div class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/MainCustomerUI.jsp">Quay lại</a><button class="btn" type="submit">Thêm mới · Đăng kí thẻ <span aria-hidden="true">→</span></button></div>
</form></section><aside class="note-panel"><p class="eyebrow">THẺ THƯ VIỆN CỦA BẠN</p><div class="mini-card"><div class="library">LIBRARY / UNIVERSITY LIBRARY</div><div class="card-name">THẺ BẠN ĐỌC</div><small>Đồng hành cùng hành trình tri thức</small></div><h3>Đăng kí trong một bước</h3><ol><li>Nhập thông tin của bạn.</li><li>Kiểm tra và gửi đăng kí.</li><li>Nhận mã bạn đọc và thẻ.</li></ol><p>Ngày cấp, ngày hết hạn và mã thẻ được hệ thống tạo tự động theo quy định thư viện.</p><p>Thông tin cá nhân được sử dụng để quản lý tài khoản và thẻ thư viện.</p></aside></div>
</c:otherwise></c:choose>
<%@ include file="common/footer.jspf" %>
