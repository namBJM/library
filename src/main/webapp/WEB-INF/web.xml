<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">
  <display-name>LibMan</display-name>
  <listener><listener-class>vn.ptit.libman.config.Bootstrap7</listener-class></listener>
  <filter><filter-name>security</filter-name><filter-class>vn.ptit.libman.web.SecurityFilter7</filter-class></filter>
  <filter-mapping><filter-name>security</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
  <servlet><servlet-name>library</servlet-name><servlet-class>vn.ptit.libman.web.LibraryServlet7</servlet-class></servlet>
  <servlet-mapping><servlet-name>library</servlet-name>
    <url-pattern>/</url-pattern><url-pattern>/MainCustomerUI.jsp</url-pattern>
    <url-pattern>/RegisterCardUI.jsp</url-pattern><url-pattern>/doRegisterCard.jsp</url-pattern>
    <url-pattern>/LoginUI.jsp</url-pattern><url-pattern>/logout</url-pattern>
    <url-pattern>/MainManagerUI.jsp</url-pattern><url-pattern>/SelectDocStatUI.jsp</url-pattern>
    <url-pattern>/DocumentBorrowingStatUI.jsp</url-pattern><url-pattern>/BorrowingReceiptDetailUI.jsp</url-pattern>
    <url-pattern>/BorrowingReceiptUI.jsp</url-pattern>
  </servlet-mapping>
  <servlet-mapping><servlet-name>default</servlet-name><url-pattern>/assets/*</url-pattern></servlet-mapping>
  <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/ErrorUI.jsp</location></error-page>
  <error-page><error-code>405</error-code><location>/WEB-INF/views/ErrorUI.jsp</location></error-page>
  <error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/views/ErrorUI.jsp</location></error-page>
</web-app>
